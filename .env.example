# Postgres-Verbindung, z. B. von Supabase (Project Settings → Database → Connection string, "Transaction pooler").
# Über die Supabase-Integration in Vercel kommen stattdessen POSTGRES_URL und POSTGRES_URL_NON_POOLING; die reichen auch.
# Leer lassen für die lokale Entwicklung: dann läuft eine eingebaute PGlite-Datenbank in ./.data
DATABASE_URL=

# Nur für die Ersteinrichtung des ersten Kontos (siehe README, Konten). Online Pflicht, lokal optional.
APP_PASSWORD=

# --- Pausen-Alarm bei gesperrtem Display (optional) ---
# Ohne diese Werte läuft der Pausen-Timer nur, solange die App offen ist.
# VAPID-Schlüssel erzeugen: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:du@example.com
# Upstash QStash (console.upstash.com → QStash): meldet den Ablauf zeitversetzt an die App
QSTASH_TOKEN=
QSTASH_URL=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# Öffentliche Adresse der App, falls sie nicht aus der Anfrage hervorgeht (z. B. https://training.vercel.app)
APP_URL=
